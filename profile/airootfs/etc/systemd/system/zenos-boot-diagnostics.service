[Unit]
Description=Show ZenOS boot diagnostics on the main console
After=systemd-journald.service systemd-modules-load.service
Before=display-manager.service
Wants=systemd-journald.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/zenos-boot-diagnostics
StandardOutput=console
StandardError=console
TimeoutStartSec=30

[Install]
WantedBy=graphical.target
