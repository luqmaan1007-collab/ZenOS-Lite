#!/usr/bin/env bash
set -u

{
  echo "============================================================"
  echo "ZenOS Lite boot diagnostics"
  date --iso-8601=seconds
  uname -a
  systemd --version | head -n 1
  echo
  echo "--- systemd-modules-load.service ---"
  systemctl status systemd-modules-load.service --no-pager -l || true
  echo
  echo "--- systemd-journald.service ---"
  systemctl status systemd-journald.service --no-pager -l || true
  echo
  echo "--- systemd-nsresourced.service ---"
  systemctl status systemd-nsresourced.service --no-pager -l || true
  echo
  echo "--- Boot errors (priority 3) ---"
  journalctl -b -p err --no-pager -n 60 || true
  echo
  echo "--- Module-load journal ---"
  journalctl -b -u systemd-modules-load.service --no-pager -n 40 || true
  echo "Full report: /var/log/zenos-boot-diagnostics.log"
  echo "============================================================"
} 2>&1 | tee /var/log/zenos-boot-diagnostics.log
